{
    "name": "hn/typo3-agent-bundled",
    "description": "Bundled PHP libraries for the typo3-agent extension (TER distribution).",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1",
        "phpoffice/phppresentation": "^1.1",
        "phpoffice/phpspreadsheet": "^3.10",
        "phpoffice/phpword": "^1.4",
        "smalot/pdfparser": "^2.12"
    },
    "config": {
        "optimize-autoloader": true,
        "classmap-authoritative": true,
        "sort-packages": true
    }
}
